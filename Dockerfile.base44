FROM python:3.12-slim

WORKDIR /app

# Install build deps for scipy/numpy wheels that need them, then clean up
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ && \
    rm -rf /var/lib/apt/lists/*

# Dependencies live in the image; the application source is bind-mounted by
# docker-compose.base44.yml so edits are served by the live-reload dev server.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 3000
